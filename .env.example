# ── Sanity ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=dfj16ucm
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01
# Optional: only needed if the dataset is private (read token, Viewer role).
# Used at BUILD time only — never prefix it with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# ── Site ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nasrallahtrading.com

# ── Web3Forms (https://web3forms.com) ──────────────────────────────────
# Both forms deliver to info@nasrallahtrading.com: create one access key
# for that inbox and use it for both variables.
NEXT_PUBLIC_WEB3FORMS_CONTACT_KEY=
NEXT_PUBLIC_WEB3FORMS_QUOTE_KEY=
# Set to "true" to add Web3Forms' free hCaptcha challenge to both forms
# (honeypot + timing protection are always on).
NEXT_PUBLIC_ENABLE_HCAPTCHA=false
