# Cloudflare Pages redirects — https://developers.cloudflare.com/pages/configuration/redirects/

# Sanity Studio is a single-page app: serve /studio/ for every deep link
# (e.g. /studio/structure/product). 200 = rewrite, the URL stays the same.
/studio/*   /studio/   200

# Friendly shortcuts
/quote      /ar/request-quote/   301
/admin      /studio/             301

# Products renamed after launch
/ar/products/uchida-multi-lock-safe/*   /ar/products/sakura-multi-lock-safe/   301
/en/products/uchida-multi-lock-safe/*   /en/products/sakura-multi-lock-safe/   301
/ar/products/sakura-single-steel-locker/*   /ar/products/godrej-single-steel-locker/   301
/ar/products/sakura-six-door-steel-locker/*   /ar/products/godrej-six-door-steel-locker/   301
/en/products/sakura-single-steel-locker/*   /en/products/godrej-single-steel-locker/   301
/en/products/sakura-six-door-steel-locker/*   /en/products/godrej-six-door-steel-locker/   301
